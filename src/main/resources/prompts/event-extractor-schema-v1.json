{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "catalyst_extraction_v1",
  "strict": true,
  "type": "object",
  "properties": {
    "document_relevant": { "type": "boolean" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string" },
          "family": { "type": "string", "enum": [
              "EARNINGS",
              "GUIDANCE",
              "COMMERCIAL",
              "PRODUCT_TECH",
              "CORPORATE_ACTION",
              "CAPITAL_ALLOCATION",
              "ANALYST",
              "REGULATORY",
              "LEGAL",
              "MANAGEMENT_OWNERSHIP",
              "INDUSTRY_EXTERNAL"
          ] },
          "type": { "type": "string", "enum": [
              "EARNINGS_BEAT",
              "EARNINGS_MISS",
              "REVENUE_BEAT",
              "REVENUE_MISS",
              "EPS_BEAT",
              "EPS_MISS",
              "MARGIN_EXPANSION",
              "MARGIN_COMPRESSION",
              "BOOKINGS_ACCELERATION",
              "BOOKINGS_DECELERATION",
              "BACKLOG_GROWTH",
              "BACKLOG_DECLINE",
              "GUIDANCE_RAISE",
              "GUIDANCE_CUT",
              "GUIDANCE_INITIATED",
              "GUIDANCE_WITHDRAWN",
              "GUIDANCE_ABOVE_CONSENSUS",
              "GUIDANCE_BELOW_CONSENSUS",
              "LONG_TERM_TARGET_RAISED",
              "LONG_TERM_TARGET_CUT",
              "CONTRACT_WIN",
              "CONTRACT_LOSS",
              "LARGE_ORDER",
              "ORDER_CANCELLATION",
              "CUSTOMER_WIN",
              "CUSTOMER_LOSS",
              "PARTNERSHIP_ANNOUNCED",
              "PARTNERSHIP_ENDED",
              "PRICING_INCREASE",
              "PRICING_DECREASE",
              "DEMAND_ACCELERATION",
              "DEMAND_DECELERATION",
              "PRODUCT_LAUNCH",
              "PRODUCT_DELAY",
              "BREAKTHROUGH",
              "DEVELOPMENT_MILESTONE",
              "MAJOR_CUSTOMER_ADOPTION",
              "CAPACITY_EXPANSION",
              "CAPACITY_REDUCTION",
              "PRODUCTION_INCREASE",
              "PRODUCTION_CUT",
              "ACQUISITION_ANNOUNCED",
              "ACQUISITION_COMPLETED",
              "TAKEOVER_TARGET",
              "TAKEOVER_BID",
              "DIVESTITURE",
              "SPINOFF",
              "STRATEGIC_REVIEW",
              "INDEX_INCLUSION",
              "INDEX_EXCLUSION",
              "BUYBACK_ANNOUNCED",
              "BUYBACK_INCREASED",
              "BUYBACK_SUSPENDED",
              "DIVIDEND_INITIATED",
              "DIVIDEND_INCREASED",
              "DIVIDEND_CUT",
              "DIVIDEND_SUSPENDED",
              "CAPEX_INCREASE",
              "CAPEX_CUT",
              "DEBT_ISSUANCE",
              "DEBT_REPAYMENT",
              "EQUITY_OFFERING",
              "ANALYST_UPGRADE",
              "ANALYST_DOWNGRADE",
              "PRICE_TARGET_RAISED",
              "PRICE_TARGET_CUT",
              "ESTIMATE_REVISION_UP",
              "ESTIMATE_REVISION_DOWN",
              "COVERAGE_INITIATED",
              "APPROVAL_GRANTED",
              "APPROVAL_DENIED",
              "REGULATORY_CLEARANCE",
              "REGULATORY_BLOCK",
              "LICENSE_GRANTED",
              "LICENSE_REVOKED",
              "INVESTIGATION_OPENED",
              "INVESTIGATION_CLOSED",
              "POLICY_TAILWIND",
              "POLICY_HEADWIND",
              "LAWSUIT_FILED",
              "LAWSUIT_DISMISSED",
              "LEGAL_WIN",
              "LEGAL_LOSS",
              "SETTLEMENT",
              "PATENT_WIN",
              "PATENT_LOSS",
              "CEO_APPOINTED",
              "CEO_DEPARTURE",
              "CFO_APPOINTED",
              "CFO_DEPARTURE",
              "FOUNDER_RETURN",
              "INSIDER_BUY",
              "INSIDER_SELL",
              "ACTIVIST_POSITION",
              "MAJOR_STAKE_INCREASED",
              "MAJOR_STAKE_DECREASED",
              "PEER_POSITIVE_READTHROUGH",
              "PEER_NEGATIVE_READTHROUGH",
              "CUSTOMER_CONFIRMATION",
              "CUSTOMER_WEAKNESS",
              "SUPPLIER_DISRUPTION",
              "SUPPLIER_IMPROVEMENT",
              "SECTOR_DEMAND_UP",
              "SECTOR_DEMAND_DOWN",
              "COMMODITY_TAILWIND",
              "COMMODITY_HEADWIND"
          ] },
          "direction": { "type": "string", "enum": ["POSITIVE", "NEGATIVE", "NEUTRAL", "MIXED"] },
          "confidence": { "type": "number" },
          "magnitude": { "type": ["number", "null"] },
          "surprise": { "type": ["number", "null"] },
          "materiality": { "type": ["number", "null"] },
          "expected_horizon": { "type": "string", "enum": ["INTRADAY", "DAYS", "WEEKS", "MONTHS", "STRUCTURAL"] },
          "directness": { "type": "string", "enum": ["DIRECT", "INFERRED"] },
          "event_timestamp": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quote_or_fact": { "type": "string" },
                "source_offset_hint": { "type": ["string", "null"] }
              },
              "required": ["quote_or_fact", "source_offset_hint"],
              "additionalProperties": false
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "value": { "type": "string" }
              },
              "required": ["key", "value"],
              "additionalProperties": false
            }
          }
        },
        "required": ["ticker", "family", "type", "direction", "confidence", "magnitude", "surprise", "materiality", "expected_horizon", "directness", "event_timestamp", "evidence", "attributes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["document_relevant", "events"],
  "additionalProperties": false
}
